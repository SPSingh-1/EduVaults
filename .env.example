# EduVault Centralized Environment Configuration Template
# Authoritative source for all services (.NET API, Express Auxiliary Service, and Development Tools)
# DO NOT commit real production secrets to source control.

# PostgreSQL Connection String (EF Core / Npgsql)
ConnectionStrings__DefaultConnection="Host=localhost;Database=neondb;Username=neondb_owner;Password=YOUR_POSTGRES_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;"

# Centralized JWT Signing Secret (Minimum 32 characters, shared by .NET and Express)
JWT_SECRET="YOUR_SECURE_RANDOM_JWT_SECRET_KEY_32_BYTES_MINIMUM"
Jwt__Secret="YOUR_SECURE_RANDOM_JWT_SECRET_KEY_32_BYTES_MINIMUM"

# Fixed SuperAdmin Credentials (Platform bootstrap)
SUPERADMIN_EMAIL="superadmin@eduvault.com"
SUPERADMIN_PASSWORD="YOUR_SECURE_SUPERADMIN_PASSWORD"

# Express Auxiliary Service Configuration
PORT=5005
MONGO_URI="mongodb://localhost:27017/eduvault"
RATE_LIMIT_MAX=3000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:5265,http://localhost:5005"

# Third-Party Integrations (Optional / Mockable)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
